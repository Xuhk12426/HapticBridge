<Window x:Class="HapticBridge.UI.Views.ApolloManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apollo" Width="590" Height="650" MinWidth="460" MinHeight="430"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="Notice" Margin="0,6,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel">
                <StackPanel x:Name="SignInPanel" Visibility="Collapsed">
                    <TextBlock Text="Sign in with your Apollo web UI account. HapticBridge keeps the session in memory. Apollo may sign out another open browser session."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Apollo username" />
                    <TextBox x:Name="Username" AutomationProperties.Name="Apollo username" Margin="0,4,0,9" />
                    <TextBlock Text="Apollo password" />
                    <PasswordBox x:Name="Password" AutomationProperties.Name="Apollo password" Margin="0,4,0,12" />
                    <Button Content="Sign in" Click="SignIn_Click" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel x:Name="DevicesPanel" Visibility="Collapsed">
                    <TextBlock Text="Pair a phone" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Select this PC in Artemis, then enter the four-digit PIN it shows."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10" />
                    <TextBlock Text="Device name" />
                    <TextBox x:Name="DeviceName" Text="Artemis" MaxLength="64" Margin="0,4,0,8"
                             AutomationProperties.Name="Device name" />
                    <TextBlock Text="Pairing PIN" />
                    <DockPanel Margin="0,4,0,18" LastChildFill="False">
                        <TextBox x:Name="Pin" MaxLength="4" Width="90" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Artemis PIN" Margin="0,0,8,0" />
                        <Button Content="Pair device" Click="Pair_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </DockPanel>

                    <TextBlock Text="Paired devices" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceCount" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                    <ListBox x:Name="DeviceList" DisplayMemberPath="Label" MaxHeight="150" MinHeight="55"
                             AutomationProperties.Name="Paired Artemis devices" SelectionChanged="DeviceList_SelectionChanged" />
                    <WrapPanel Margin="0,9,0,0">
                        <Button Content="Refresh list" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,5" />
                        <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,5" />
                        <Button x:Name="ForgetButton" Content="Forget device" Click="Forget_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,5" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                    <TextBlock Text="Use Remote Input in Artemis to play on the PC display. Enabling Controller + Audio also enables the Remote Input entry and Apollo audio streaming."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                    <CheckBox x:Name="ControllerAudio" Content="Enable Controller + Audio" Foreground="{StaticResource TextPrimaryBrush}"
                              Checked="ControllerAudio_Changed" Unchecked="ControllerAudio_Changed" Margin="0,0,0,10" />
                    <CheckBox x:Name="SeparateGrips" Content="Stream separate DualSense grip channels" Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="Use stereo in Artemis for separate grip channels. Listen to game audio through the PC output selected in HapticBridge."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                    <Button Content="Save for next Apollo start" Click="SaveAudio_Click"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="StopPanel" Visibility="Collapsed">
                    <TextBlock Text="Stopping Apollo ends all active streams. Paired devices are saved for next time."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,15" />
                    <Button Content="Stop host now" Click="Stop_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
