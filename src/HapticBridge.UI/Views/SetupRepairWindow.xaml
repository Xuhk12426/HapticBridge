<Window x:Class="HapticBridge.UI.Views.SetupRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:repair="clr-namespace:HapticBridge.Setup.Engine;assembly=HapticBridge.Setup"
        Title="Setup / Repair"
        Height="580" Width="560" MinHeight="460" MinWidth="460"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="RepairPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepairSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Setup / Repair" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                         AutomationProperties.Name="Setup progress" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCardStyle}" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Component}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                           FontWeight="SemiBold" Margin="8,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.Planned}">
                                                    <Setter Property="Foreground" Value="#93C5FD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.Configured}">
                                                    <Setter Property="Foreground" Value="#86EFAC" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.Verified}">
                                                    <Setter Property="Foreground" Value="#86EFAC" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.NeedsAttention}">
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.Unverified}">
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BackupPaths, Mode=OneWay}"
                                         IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Configuration backup paths"
                                         AutomationProperties.Name="Configuration backup paths">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupPaths}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                        Content="Repair HidHide access" Margin="0,8,0,0"
                                        Command="{Binding DataContext.RepairHidHideCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RepairSecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Component}" Value="HidHide" />
                                                        <Condition Binding="{Binding State}" Value="{x:Static repair:SetupRepairState.Planned}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Apply repairs backs up settings before making the listed changes."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <Button Content="Check again" Command="{Binding CheckCommand}" HorizontalAlignment="Left"
                        Style="{StaticResource RepairSecondaryButton}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyRepairsButton" Content="Apply repairs" Command="{Binding ApplyCommand}"
                            Style="{StaticResource RepairPrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Close" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RepairSecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
