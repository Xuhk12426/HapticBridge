<Window x:Class="HapticBridge.UI.Views.NativeTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller and audio tests"
        Width="580" Height="560" MinWidth="450" MinHeight="480"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TestPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="TestHeading" Text="Controller and audio tests" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="TestDescription" Text="The virtual DualSense stays connected while the app is open. The audio test runs for up to 60 seconds."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Close" Click="Close_Click"
                Style="{StaticResource TestSecondaryButton}" Margin="0,8,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="ControllerControls" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Virtual DualSense" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Controller.Status}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel>
                            <Button x:Name="StartControllerButton" Content="Enable DualSense haptics" Command="{Binding Controller.StartCommand}"
                                    Style="{StaticResource TestPrimaryButton}" Margin="0,0,8,4" />
                            <Button Content="Disable haptics" Command="{Binding Controller.StopCommand}"
                                    Style="{StaticResource TestSecondaryButton}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DualSense audio to VB-CABLE" FontSize="16" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Target="{Binding ElementName=SourcePicker}" Content="DualSense" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ComboBox x:Name="SourcePicker" Grid.Column="1" ItemsSource="{Binding Sources}"
                                      DisplayMemberPath="FriendlyName" SelectedItem="{Binding Source}" Margin="4,0,0,5" />
                            <Label Grid.Row="1" Target="{Binding ElementName=CablePicker}" Content="VB-CABLE" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ComboBox x:Name="CablePicker" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Cables}"
                                      DisplayMemberPath="FriendlyName" SelectedItem="{Binding Cable}" Margin="4,0,0,5" />
                        </Grid>
                        <TextBlock Text="{Binding AudioStatus}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel>
                            <Button x:Name="StartAudioButton" Content="Start audio test" Command="{Binding StartAudioCommand}"
                                    Style="{StaticResource TestPrimaryButton}" Margin="0,0,8,4" />
                            <Button Content="Stop audio test" Command="{Binding StopAudioCommand}"
                                    Style="{StaticResource TestSecondaryButton}" Margin="0,0,8,4" />
                            <Button Content="Refresh endpoints" Command="{Binding RefreshEndpointsCommand}"
                                    Style="{StaticResource TestSecondaryButton}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
