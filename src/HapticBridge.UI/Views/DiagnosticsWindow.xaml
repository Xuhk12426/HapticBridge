<Window x:Class="HapticBridge.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Diagnostics &amp; Inspection"
        Height="560" Width="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Diagnostic report"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Review the device names and file paths in this local report before sharing it." TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Body: Scrollable Report Text -->
        <Border Grid.Row="1"
                Background="#0F172A"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ReportContent, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#E2E8F0"
                         BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="12"
                         TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2">
            <WrapPanel>
                <Button x:Name="NativeTestsButton" Content="VB-CABLE test" Click="NativeTests_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" FontSize="12" Margin="0,0,8,0" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshReportCommand}" Padding="14,8" FontSize="12" Margin="0,0,8,0" />
                <Button Content="Save report…" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CanSave}" Click="SaveReport_Click" Padding="14,8" FontSize="12" />
            </WrapPanel>
            <TextBlock Text="{Binding ExportStatusMessage}"
                       FontSize="12"
                       Foreground="#38BDF8"
                       Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
