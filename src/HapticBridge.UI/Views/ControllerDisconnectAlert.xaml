<Window x:Class="HapticBridge.UI.Views.ControllerDisconnectAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:HapticBridge.Core;assembly=HapticBridge.Core"
        Title="Virtual DualSense disconnect notification"
        Width="360" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Padding="16,12" BorderBrush="#EAB308" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{x:Static core:AppBranding.Name}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="Virtual DualSense disconnected" Margin="0,4,0,4" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</Window>
